# =======================================================
# CONFIGURACIÓN DE BASE DE DATOS - Evolución Tiempos App
# =======================================================
# Copiar este archivo como .env y configurar los valores

# Tipo de base de datos: sqlite o postgresql
DB_TYPE=sqlite

# --- Configuración SQLite (solo si DB_TYPE=sqlite) ---
# Ruta al archivo de base de datos SQLite
DB_PATH=montaje.db

# --- Configuración PostgreSQL (solo si DB_TYPE=postgresql) ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=tiempos_fabricacion
# DB_USER=postgres
# DB_PASSWORD=your_secure_password_here

# --- Opciones de Desarrollo ---
# Mostrar consultas SQL en los logs (True/False)
DB_ECHO=False

# --- Rutas de la Aplicación ---
# Directorio de logs
LOG_DIR=logs

# Directorio de backups
BACKUP_DIR=backups
